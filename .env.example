DUCKFLEET_PROJECT_ID=your-gcp-project
DUCKFLEET_REGION=us-central1
DUCKFLEET_MODEL_FAST=gemini-3.5-flash
DUCKFLEET_MODEL_STRONG=gemini-3.5-pro
# Swap any tier to Claude on Vertex Model Garden without code changes:
# DUCKFLEET_MODEL_STRONG=vertex_ai/claude-sonnet-4-5
DUCKFLEET_HOME_LAT=-27.52
DUCKFLEET_HOME_LNG=153.04
DUCKFLEET_SPEND_CAP_AUD_PER_WEEK=100
# Who receives the morning brief (single recipient for now; per-user later).
DUCKFLEET_NOTIFY_EMAIL=you@example.com
# Gmail send (optional; leave blank to just log the brief). Secrets — never commit real
# values. Create a Desktop OAuth client, then run scripts/gmail_authorize.py for the token.
DUCKFLEET_GMAIL_SENDER=you@example.com
DUCKFLEET_GMAIL_CLIENT_ID=
DUCKFLEET_GMAIL_CLIENT_SECRET=
DUCKFLEET_GMAIL_REFRESH_TOKEN=
